# Frontend configuration (CRA only exposes env vars prefixed with REACT_APP_)
# Set at runtime/deploy time; do NOT commit .env with secrets.

# If set, the app will use this base URL for API calls.
# If not set, the app falls back to the built-in mock adapter.
REACT_APP_API_BASE=

# Optional alternate backend URL (used if API_BASE is missing)
REACT_APP_BACKEND_URL=

# Optional informational URLs
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=

# Runtime behavior
REACT_APP_NODE_ENV=development
REACT_APP_LOG_LEVEL=info

# Feature flags (comma separated)
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false
